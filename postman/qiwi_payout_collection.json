{
  "info": {
    "name": "QIWI Payout API Tests",
    "description": "Тестовая коллекция для проверки API выплат QIWI\nДокументация: https://developer.qiwi.com/ru/payout/v1/",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "https://edge.qiwi.com"
    },
    {
      "key": "token",
      "value": "YOUR_TOKEN_HERE"
    },
    {
      "key": "test_account",
      "value": "TEST_ACCOUNT_NUMBER"
    }
  ],
  "item": [
    {
      "name": "1. Проверка доступности",
      "item": [
        {
          "name": "GET /rates (публичный метод)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Сервис отвечает (200 или 401)', function() {",
                  "    pm.expect(pm.response.code).to.be.oneOf([200, 401]);",
                  "});",
                  "",
                  "pm.test('Ответ в формате JSON', function() {",
                  "    pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json');",
                  "});",
                  "",
                  "var data = pm.response.json();",
                  "pm.test('Структура ответа соответствует документации', function() {",
                  "    if (pm.response.code === 200) {",
                  "        pm.expect(data).to.be.an('object');",
                  "    } else {",
                  "        pm.expect(data).to.have.any.keys('message', 'error');",
                  "    }",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/v2/rates",
              "host": ["{{base_url}}"],
              "path": ["api", "v2", "rates"]
            }
          }
        }
      ]
    },
    {
      "name": "2. Запрос баланса",
      "item": [
        {
          "name": "GET /balance (balance > 0)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Статус 200', function() {",
                  "    pm.expect(pm.response.code).to.equal(200);",
                  "});",
                  "",
                  "var data = pm.response.json();",
                  "",
                  "pm.test('Поле balance существует', function() {",
                  "    pm.expect(data).to.have.property('balance');",
                  "});",
                  "",
                  "pm.test('Баланс больше 0', function() {",
                  "    pm.expect(data.balance).to.be.above(0);",
                  "    console.log('Баланс:', data.balance, data.currency);",
                  "});",
                  "",
                  "pm.test('Поле currency = RUB', function() {",
                  "    pm.expect(data.currency).to.equal('RUB');",
                  "});",
                  "",
                  "pm.environment.set('balance', data.balance);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {"key": "Authorization", "value": "Bearer {{token}}"},
              {"key": "Accept", "value": "application/json"}
            ],
            "url": {
              "raw": "{{base_url}}/partner/payout/v1/balance",
              "host": ["{{base_url}}"],
              "path": ["partner", "payout", "v1", "balance"]
            }
          }
        }
      ]
    },
    {
      "name": "3. Создание платежа",
      "item": [
        {
          "name": "POST /claims (1 рубль)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Статус 200 или 201', function() {",
                  "    pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
                  "});",
                  "",
                  "var data = pm.response.json();",
                  "",
                  "pm.test('Ответ содержит id', function() {",
                  "    pm.expect(data).to.have.property('id');",
                  "    pm.environment.set('claim_id', data.id);",
                  "});",
                  "",
                  "pm.test('Ответ содержит status', function() {",
                  "    pm.expect(data).to.have.property('status');",
                  "    pm.expect(data.status).to.be.oneOf(['NEW', 'ACCEPTED', 'PROCESSING']);",
                  "});",
                  "",
                  "console.log('Создана заявка:', data.id, 'статус:', data.status);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {"key": "Authorization", "value": "Bearer {{token}}"},
              {"key": "Content-Type", "value": "application/json"},
              {"key": "Accept", "value": "application/json"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id\": \"{{$guid}}\",\n  \"sum\": {\n    \"amount\": 1.00,\n    \"currency\": \"RUB\"\n  },\n  \"paymentMethod\": {\n    \"type\": \"Account\",\n    \"accountId\": \"643\"\n  },\n  \"purpose\": \"Тестовый платеж на 1 рубль\",\n  \"fields\": {\n    \"account\": \"{{test_account}}\"\n  }\n}"
            },
            "url": {
              "raw": "{{base_url}}/partner/payout/v1/claims",
              "host": ["{{base_url}}"],
              "path": ["partner", "payout", "v1", "claims"]
            }
          }
        }
      ]
    },
    {
      "name": "4. Исполнение платежа",
      "item": [
        {
          "name": "GET /claims/{id} (статус выплаты)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Статус 200', function() {",
                  "    pm.expect(pm.response.code).to.equal(200);",
                  "});",
                  "",
                  "var data = pm.response.json();",
                  "",
                  "pm.test('ID совпадает', function() {",
                  "    pm.expect(data.id).to.equal(pm.environment.get('claim_id'));",
                  "});",
                  "",
                  "pm.test('Статус изменился с NEW', function() {",
                  "    pm.expect(data.status).to.not.equal('NEW');",
                  "    console.log('Статус выплаты:', data.status);",
                  "});",
                  "",
                  "pm.test('Сумма = 1.00 RUB', function() {",
                  "    if (data.sum) {",
                  "        pm.expect(data.sum.amount).to.equal(1.00);",
                  "        pm.expect(data.sum.currency).to.equal('RUB');",
                  "    }",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {"key": "Authorization", "value": "Bearer {{token}}"},
              {"key": "Accept", "value": "application/json"}
            ],
            "url": {
              "raw": "{{base_url}}/partner/payout/v1/claims/{{claim_id}}",
              "host": ["{{base_url}}"],
              "path": ["partner", "payout", "v1", "claims", "{{claim_id}}"]
            }
          }
        }
      ]
    }
  ]
}